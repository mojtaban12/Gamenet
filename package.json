{
  "name": "targame-app",
  "version": "1.0.75",
  "description": "TarGame - Online Gaming Platform",
  "author": "Tar Team",
  "main": "electron/main.js",
  "scripts": {
    "dev": "concurrently \"vite\" \"wait-on http://localhost:5173 && electron .\"",
    "build:win": "vite build --outDir build/web && electron-builder --win",
    "build:dir": "vite build --outDir build/web && electron-builder --win --dir",
    "preview": "vite preview"
  },
  "dependencies": {
    "@microsoft/signalr": "^8.0.0",
    "adm-zip": "^0.5.10",
    "axios": "^1.6.0",
    "electron-updater": "^6.8.9",
    "i18next": "^26.3.4",
    "livekit-client": "^2.19.1",
    "lucide-react": "^1.17.0",
    "obs-websocket-js": "^5.0.8",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "react-i18next": "^17.0.8",
    "react-router-dom": "^6.20.0",
    "zustand": "^4.4.0"
  },
  "devDependencies": {
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "autoprefixer": "^10.4.16",
    "concurrently": "^8.2.0",
    "electron": "^43.0.0",
    "electron-builder": "^26.15.3",
    "postcss": "^8.4.32",
    "tailwindcss": "^3.3.6",
    "vite": "^8.1.3",
    "wait-on": "^7.2.0"
  },
  "build": {
    "appId": "com.targame.app",
    "productName": "TarGame",
    "directories": {
      "buildResources": "assets",
      "output": "release"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "requireAdministrator"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": true,
      "allowToChangeInstallationDirectory": true,
      "allowElevation": true,
      "deleteAppDataOnUninstall": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "TarGame",
      "installerIcon": "assets/icon.ico",
      "uninstallerIcon": "assets/icon.ico",
      "installerHeader": "assets/icon.ico"
    },
    "publish": {
      "provider": "generic",
      "url": "s3.blockbone.ir/targame/"
    },
    "files": [
      "build/web/**/*",
      "electron/**/*",
      "assets/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/",
        "to": "vendor/",
        "filter": [
          "**/*"
        ]
      }
    ]
  },
  "allowScripts": {
    "electron@43.0.0": true
  }
}
